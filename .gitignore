# Build outputs
_build/
_figures/

# Node
node_modules/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.ruff_cache/
.venv/
.pytest_cache/

# Node (interactive figures)
interactive/node_modules/

# Env files
interactive/.env

# OS
.DS_Store

# Playwright MCP session artifacts (logs + DOM snapshots from browser_navigate)
.playwright-mcp/
# Loose screenshots saved by the playwright MCP browser_take_screenshot tool
*-baseline.png
*-after-D*.png

# Spike outputs — regenerable from the notebook, some SVGs exceed GitHub size limits
tools/spikes/*.html
tools/spikes/*.svg
tools/spikes/*.spec.json

# Vale — downloaded style packages live under here, synced via `make lint-sync`.
# MLPaper rules and the MLPaper vocabulary are tracked; package downloads are not.
.vale/styles/Microsoft/
# Stale leftovers from before the Microsoft swap; safe to delete locally.
.vale/styles/proselint/
.vale/styles/write-good/
