---
// Recursive MyST mdast renderer. One Astro component dispatches on node.type
// and recurses for children. Coverage is intentionally minimal — paragraph,
// heading, lists, code, links, math, container/admonition, block, image,
// iframe, html passthrough. Add cases as needed.

import type { MystNode } from '../lib/content';
const { node } = Astro.props as { node: MystNode };

const t = node.type;
const children = (node.children ?? []) as MystNode[];

// Heading depths past 6 collapse to <h6>; HTML doesn't go higher.
const depth = Math.min(Number(node.depth ?? 1), 6);

// Class lists: MyST blocks carry their class as `node.class` (post-AST shape).
// `+++ {"class": "col-screen slide-full"}` lands as { type:'block', class:'col-screen slide-full' }.
const cls = typeof node.class === 'string' ? node.class : undefined;
const id = typeof node.identifier === 'string' ? node.identifier : undefined;

const url = typeof node.url === 'string' ? node.url : '#';
const alt = typeof node.alt === 'string' ? node.alt : '';
const lang = typeof node.lang === 'string' ? node.lang : '';
const value = typeof node.value === 'string' ? node.value : '';
const ordered = node.ordered === true;
const src = typeof node.src === 'string' ? node.src : '';
const enumerator = node.enumerator;
const kind = typeof node.kind === 'string' ? node.kind : '';
const label = typeof node.label === 'string' ? node.label : '';
const identifier = typeof node.identifier === 'string' ? node.identifier : '';
---
{t === 'root' && children.map(c => <Astro.self node={c} />)}

{t === 'paragraph' && <p>{children.map(c => <Astro.self node={c} />)}</p>}

{t === 'heading' && (
  depth === 1 ? <h1 id={id}>{children.map(c => <Astro.self node={c} />)}</h1>
  : depth === 2 ? <h2 id={id}>{children.map(c => <Astro.self node={c} />)}</h2>
  : depth === 3 ? <h3 id={id}>{children.map(c => <Astro.self node={c} />)}</h3>
  : depth === 4 ? <h4 id={id}>{children.map(c => <Astro.self node={c} />)}</h4>
  : depth === 5 ? <h5 id={id}>{children.map(c => <Astro.self node={c} />)}</h5>
  :              <h6 id={id}>{children.map(c => <Astro.self node={c} />)}</h6>
)}

{t === 'text' && value}

{t === 'emphasis' && <em>{children.map(c => <Astro.self node={c} />)}</em>}
{t === 'strong' && <strong>{children.map(c => <Astro.self node={c} />)}</strong>}
{t === 'inlineCode' && <code>{value}</code>}
{t === 'break' && <br />}
{t === 'thematicBreak' && <hr />}

{t === 'link' && <a href={url}>{children.map(c => <Astro.self node={c} />)}</a>}

{t === 'list' && (ordered
  ? <ol>{children.map(c => <Astro.self node={c} />)}</ol>
  : <ul>{children.map(c => <Astro.self node={c} />)}</ul>
)}
{t === 'listItem' && <li>{children.map(c => <Astro.self node={c} />)}</li>}

{t === 'blockquote' && <blockquote>{children.map(c => <Astro.self node={c} />)}</blockquote>}

{t === 'code' && <pre><code class={lang ? `language-${lang}` : undefined}>{value}</code></pre>}

{/* Math: render as LaTeX inside a delimited span/div. A KaTeX/MathJax
    client script picks these up at load time. */}
{t === 'inlineMath' && <span class="math inline">{`\\(${value}\\)`}</span>}
{t === 'math' && <div class="math display" id={id}>{`\\[${value}\\]`}</div>}

{t === 'image' && <img src={url || src} alt={alt} />}

{/* Iframe figures live under _build/figures/. Adjust path when wiring CI. */}
{t === 'iframe' && <iframe src={src} title={alt || identifier} loading="lazy" />}

{/* Block: +++ separator with class metadata. The class survives so
    `col-screen`, `slide-full`, etc. work the same as in article-theme. */}
{t === 'block' && <div id={id} class={cls}>{children.map(c => <Astro.self node={c} />)}</div>}

{/* Container: figure / table wrapper from `:::{figure}` or `:::{table}`. */}
{t === 'container' && (
  <figure id={id} class={kind ? `container-${kind}` : undefined}>
    {children.map(c => <Astro.self node={c} />)}
  </figure>
)}

{t === 'caption' && <figcaption>{children.map(c => <Astro.self node={c} />)}</figcaption>}

{/* Admonition: render as a styled aside. Class carries the kind (note/warning/etc). */}
{t === 'admonition' && (
  <aside class={`admonition ${cls ?? ''}`.trim()}>
    {children.map(c => <Astro.self node={c} />)}
  </aside>
)}
{t === 'admonitionTitle' && <p class="admonition-title"><strong>{children.map(c => <Astro.self node={c} />)}</strong></p>}

{/* Citations and cross-refs: minimal text-only fallback for now. */}
{t === 'cite' && <span class="cite" data-key={label || identifier}>[{label || identifier}]</span>}
{t === 'citeGroup' && <span class="cite-group">{children.map(c => <Astro.self node={c} />)}</span>}
{t === 'crossReference' && (
  <a href={`#${identifier}`}>
    {children.length
      ? children.map(c => <Astro.self node={c} />)
      : (typeof node.template === 'string' && enumerator != null
          ? (node.template as string).replace('%s', String(enumerator))
          : identifier)}
  </a>
)}

{/* Raw HTML passthrough (MyST emits these for inline HTML or directives that bake to HTML). */}
{t === 'html' && <Fragment set:html={value} />}

{/* Transparent wrappers — render children, drop the node. */}
{(t === 'mystDirective' || t === 'mystRole' || t === 'output' || t === 'outputs' || t === 'include' || t === 'legend') &&
  children.map(c => <Astro.self node={c} />)}

{/* Ignore comments and unknown leaves silently in the rendered output;
    log a warning at build time so we know what to add. */}
{(t === 'comment' || t === 'mystComment') && null}
