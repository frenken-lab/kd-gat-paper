---
// Bare HTML shell. Loads global stylesheets from _static/ via root-level
// links so the existing custom.css / story.css continue to apply.
const { title, description } = Astro.props as {
  title?: string;
  description?: string;
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? 'KD-GAT'}</title>
    {description && <meta name="description" content={description} />}
    <link rel="stylesheet" href="/_static/custom.css" />
    <link rel="stylesheet" href="/_static/story.css" />
    {/* MathJax inline; swap for KaTeX if you'd rather. */}
    <script
      src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"
      is:inline
      async></script>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
